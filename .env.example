# G-Krusch / G-Crush — Environment Configuration
# Host & Port for G-Krusch Hub and MCP Server (defaults to loopback 127.0.0.1)
HOST=127.0.0.1
PORT=5446

# Base URL for OAuth redirects and links
BASE_URL=http://localhost:5446

# Google OAuth 2.0 Credentials
# Create or obtain from Google Cloud Console (APIs: Google Drive API, Google Docs API, Calendar API, Gmail API)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5446/auth/google/callback

# Google Drive Workspace Folder Name in your Drive root
# G-Krusch will find or automatically create this folder to house agent.md and subdirectories
WORKSPACE_FOLDER_NAME=G-Krusch

# Optional: Specific Google Drive Folder ID (if you already have one)
# GOOGLE_DRIVE_FOLDER_ID=

# Local GPU Ollama Embeddings (Tier 1 Primary — 1,024-dim sovereign embeddings)
OLLAMA_URL=http://localhost:11434/api/embeddings
OLLAMA_MODEL=bge-large:latest

# Gemini API Key & Model (Tier 2 Fallback — 1,024-dim via outputDimensionality: 1024)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBED_MODEL=models/gemini-embedding-001

# Optional: Shared Secret / API Key for AES-256-GCM key derivation & endpoint guard (constant-time verified)
# GCRUSH_SECRET=
# API_KEY=
# CORS_ORIGINS=http://localhost:5446,http://localhost:3004

# Local SQLite Database Path
DATABASE_PATH=./data/gcrush.db
