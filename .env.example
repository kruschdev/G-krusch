# G-Krusch / G-Crush — Environment Configuration
# Port for G-Krusch Hub and MCP Server
PORT=5446

# Base URL for OAuth redirects and links
BASE_URL=http://localhost:5446

# Google OAuth 2.0 Credentials
# Create or obtain from Google Cloud Console (APIs: Google Drive API, Google Docs API)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5446/auth/google/callback

# Google Drive Workspace Folder Name in your Drive root
# G-Krusch will find or automatically create this folder to house agent.md and subdirectories
WORKSPACE_FOLDER_NAME=G-Krusch

# Optional: Specific Google Drive Folder ID (if you already have one)
# GOOGLE_DRIVE_FOLDER_ID=

# Gemini API Key (for semantic vector embeddings in Drive RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Local Ollama URL (fallback for embeddings)
OLLAMA_URL=http://localhost:11434/api/embeddings
OLLAMA_MODEL=nomic-embed-text

# Local SQLite Database Path
DATABASE_PATH=./data/gcrush.db
